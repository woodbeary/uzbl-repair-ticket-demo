{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uzbl-portal-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Add your own custom domain here if you need one, e.g.
  // "routes": [{ "pattern": "repairs.example.com", "custom_domain": true }],
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "DEMO_KV" }],
  "ratelimits": [{ "name": "INTAKE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": { "AI_GATEWAY_ID": "default" },
  "observability": { "enabled": true }
}
