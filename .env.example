# Copy to .dev.vars (for `wrangler dev`) or set as Worker variables when deploying.
# Placeholder values only. Never commit real values.

# Cloudflare AI Gateway id that model calls are routed through.
AI_GATEWAY_ID=your-ai-gateway-id

# Set to "mock" to use the built-in keyword fallback instead of Workers AI
# (no Cloudflare login needed). Leave unset to call the real models.
DEMO_AI=mock

# Only needed for `wrangler deploy` from CI; locally use `npx wrangler login`.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
