{
  "name": "uzbl-portal-demo",
  "private": true,
  "type": "module",
  "description": "Standalone demo of UZBL repair intake (drop any file) and the repair tracker. Fake data only.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && wrangler dev -c wrangler.dev.jsonc --port 8788",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "samples": "python3 samples/make_samples.py && node samples/make_screenshot.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "fflate": "0.8.3",
    "geist": "1.7.2",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.152.0"
  }
}
